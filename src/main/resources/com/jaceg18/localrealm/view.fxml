<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import java.net.URL?>
<BorderPane xmlns="http://javafx.com/javafx/24.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.jaceg18.localrealm.Controller"
            minWidth="980.0" minHeight="640.0">

    <stylesheets>
        <URL value="@../../../theme.css" />
    </stylesheets>

    <top>
        <VBox spacing="8.0" styleClass="card" maxWidth="Infinity">
            <padding>
                <Insets bottom="15.0" left="20.0" right="20.0" top="15.0"/>
            </padding>
            <HBox alignment="CENTER_LEFT" spacing="16.0" maxWidth="Infinity">
                <VBox spacing="2.0" maxWidth="Infinity">
                    <Label styleClass="h1" text="LocalRealm v1.0">
                        <font>
                            <Font name="System Bold" size="28.0"/>
                        </font>
                    </Label>
                    <Label styleClass="muted" text="Created By Jace Grant"/>
                </VBox>

                <Region HBox.hgrow="ALWAYS"/>

                <ImageView fitHeight="44.0" preserveRatio="true" pickOnBounds="true">
                    <Image url="@../../../icons/localrealm.png"/>
                </ImageView>
            </HBox>
        </VBox>
    </top>

    <center>
        <TabPane fx:id="mainTabPane" tabClosingPolicy="UNAVAILABLE">

            <Tab text="Build Server">
                <SplitPane dividerPositions="0.38">

                    <VBox spacing="18.0" styleClass="card" maxWidth="Infinity" maxHeight="Infinity">
                        <padding>
                            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
                        </padding>
                        <VBox spacing="8.0" maxWidth="Infinity">
                            <Label styleClass="h2" text="Build Type:"/>
                            <ChoiceBox fx:id="buildBox" maxWidth="Infinity"/>
                        </VBox>

                        <VBox spacing="8.0" maxWidth="Infinity">
                            <HBox spacing="15.0" maxWidth="Infinity">
                                <VBox spacing="5.0" HBox.hgrow="ALWAYS"/>
                                <VBox spacing="5.0" HBox.hgrow="ALWAYS"/>
                            </HBox>
                        </VBox>

                        <VBox spacing="10.0" maxWidth="Infinity">
                            <Label styleClass="h2" text="Options:"/>
                            <CheckBox fx:id="autoEulaCB" text="Auto EULA"/>
                        </VBox>

                        <Region VBox.vgrow="ALWAYS"/>

                        <Button fx:id="buildBtn"
                                onAction="#buildServer"
                                prefHeight="40.0"
                                maxWidth="Infinity"
                                styleClass="btn-primary"
                                text="Build Server"/>

                        <VBox spacing="6.0" maxWidth="Infinity">
                            <ProgressBar fx:id="progressBar" maxWidth="Infinity" progress="0.0"/>
                            <Label fx:id="statusLabel" styleClass="muted" text="Ready" wrapText="true"/>
                        </VBox>

                    </VBox>

                    <VBox spacing="10.0" styleClass="card" maxWidth="Infinity" maxHeight="Infinity">
                        <padding>
                            <Insets bottom="12.0" left="12.0" right="12.0" top="12.0"/>
                        </padding>
                        <HBox alignment="CENTER_LEFT" spacing="10.0" maxWidth="Infinity">
                            <Label styleClass="h2" text="Console Output:"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button fx:id="clearConsoleBtn" onAction="#clearConsole" text="Clear"/>
                        </HBox>

                        <ScrollPane fx:id="consoleScrollPane"
                                    fitToWidth="true"
                                    fitToHeight="true"
                                    hbarPolicy="NEVER"
                                    styleClass="console-scroll"
                                    maxWidth="Infinity"
                                    maxHeight="Infinity"
                                    VBox.vgrow="ALWAYS">
                            <TextArea fx:id="consoleArea"
                                      wrapText="true"
                                      styleClass="console"
                                      maxWidth="Infinity"
                                      maxHeight="Infinity"/>
                        </ScrollPane>

                    </VBox>

                </SplitPane>
            </Tab>

            <Tab text="Manage Servers">
                <SplitPane dividerPositions="0.28">

                    <VBox spacing="12.0" maxWidth="Infinity" maxHeight="Infinity">
                        <VBox spacing="12.0" styleClass="card" maxWidth="Infinity" VBox.vgrow="ALWAYS">
                            <padding>
                                <Insets bottom="15.0" left="15.0" right="15.0" top="15.0"/>
                            </padding>
                            <HBox alignment="CENTER_LEFT" spacing="10.0" maxWidth="Infinity">
                                <Label styleClass="h2" text="Saved Servers:"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Button fx:id="refreshServersBtn" onAction="#refreshServers"
                                        text="Refresh"/>
                            </HBox>

                            <ListView fx:id="serverListView"
                                      maxWidth="Infinity"
                                      maxHeight="Infinity"
                                      VBox.vgrow="ALWAYS"/>

                            <HBox spacing="10.0" maxWidth="Infinity">
                                <Button fx:id="addServerBtn"
                                        onAction="#addServer"
                                        maxWidth="Infinity"
                                        HBox.hgrow="ALWAYS"
                                        styleClass="btn-primary"
                                        text="Add Server"/>
                                <Button fx:id="removeServerBtn"
                                        onAction="#removeServer"
                                        maxWidth="Infinity"
                                        HBox.hgrow="ALWAYS"
                                        styleClass="btn-danger"
                                        text="Remove"/>
                            </HBox>

                        </VBox>

                        <VBox spacing="12.0" styleClass="card" maxWidth="Infinity">
                            <padding>
                                <Insets bottom="15.0" left="15.0" right="15.0" top="15.0"/>
                            </padding>
                            <Label styleClass="h2" text="Server Statistics"/>

                            <VBox spacing="8.0" maxWidth="Infinity">
                                <HBox spacing="10.0" alignment="CENTER_LEFT" maxWidth="Infinity">
                                    <Label styleClass="stat-label" text="Status:"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Label fx:id="statStatusLabel" styleClass="stat-value"
                                           text="Stopped"/>
                                </HBox>

                                <HBox spacing="10.0" alignment="CENTER_LEFT" maxWidth="Infinity">
                                    <Label styleClass="stat-label" text="Uptime:"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Label fx:id="statUptimeLabel" styleClass="stat-value"
                                           text="--:--:--"/>
                                </HBox>

                                <HBox spacing="10.0" alignment="CENTER_LEFT" maxWidth="Infinity">
                                    <Label styleClass="stat-label" text="Memory Usage:"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Label fx:id="statMemoryLabel" styleClass="stat-value"
                                           text="0 MB / 0 MB"/>
                                </HBox>

                                <HBox spacing="10.0" alignment="CENTER_LEFT" maxWidth="Infinity">
                                    <Label styleClass="stat-label" text="CPU Usage:"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Label fx:id="statCpuLabel" styleClass="stat-value"
                                           text="0.0%"/>
                                </HBox>

                                <HBox spacing="10.0" alignment="CENTER_LEFT" maxWidth="Infinity">
                                    <Label styleClass="stat-label" text="Threads:"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Label fx:id="statThreadsLabel" styleClass="stat-value"
                                           text="0"/>
                                </HBox>
                            </VBox>
                        </VBox>

                    </VBox>

                    <VBox spacing="12.0" styleClass="card" maxWidth="Infinity" maxHeight="Infinity">
                        <padding>
                            <Insets bottom="15.0" left="15.0" right="15.0" top="15.0"/>
                        </padding>
                        <HBox alignment="CENTER_LEFT" spacing="10.0" maxWidth="Infinity">
                            <Label fx:id="serverConsoleLabel" styleClass="h2" text="Server Console:"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button fx:id="clearServerConsoleBtn" onAction="#clearServerConsole"
                                    text="Clear"/>
                        </HBox>

                        <ScrollPane fx:id="serverConsoleScrollPane"
                                    fitToWidth="true"
                                    fitToHeight="true"
                                    hbarPolicy="NEVER"
                                    styleClass="console-scroll"
                                    maxWidth="Infinity"
                                    maxHeight="Infinity"
                                    VBox.vgrow="ALWAYS">
                            <TextArea fx:id="serverConsoleArea"
                                      wrapText="true"
                                      styleClass="console"
                                      maxWidth="Infinity"
                                      maxHeight="Infinity"/>
                        </ScrollPane>

                        <HBox spacing="16.0" maxWidth="Infinity">
                            <VBox spacing="10.0" maxWidth="Infinity" HBox.hgrow="ALWAYS">
                                <TextField fx:id="consoleField" promptText="Send to Console"
                                           maxWidth="Infinity"/>

                                <Label styleClass="h2" text="Options:"/>
                                <CheckBox fx:id="noGuiCB" text="No GUI"/>

                                <Label styleClass="h2" text="Memory Allocation (GB):"/>

                                <HBox spacing="12.0">
                                    <VBox spacing="5.0">
                                        <Label styleClass="h2" text="Min:"/>
                                        <Spinner fx:id="minAlocSpinner" editable="true"
                                                 prefWidth="120.0"/>
                                    </VBox>
                                    <VBox spacing="5.0">
                                        <Label styleClass="h2" text="Max:"/>
                                        <Spinner fx:id="maxAlocSpinner" editable="true"
                                                 prefWidth="120.0"/>
                                    </VBox>
                                </HBox>
                            </VBox>

                            <VBox spacing="10.0" alignment="TOP_RIGHT">
                                <Button fx:id="sendConsoleBtn"
                                        mnemonicParsing="false"
                                        onAction="#sendConsole"
                                        text="Send"
                                        maxWidth="Infinity"/>

                                <HBox spacing="10.0">
                                    <Button fx:id="runSelectedServerBtn"
                                            onAction="#runSelectedServer"
                                            prefHeight="39.0"
                                            minWidth="100.0"
                                            styleClass="btn-primary"
                                            text="Start"/>
                                    <Button fx:id="stopServerBtn"
                                            onAction="#stopServer"
                                            prefHeight="35.0"
                                            minWidth="100.0"
                                            styleClass="btn-danger"
                                            text="Stop"/>
                                </HBox>
                            </VBox>

                        </HBox>

                    </VBox>

                </SplitPane>
            </Tab>

            <Tab text="Settings">
                <SplitPane dividerPositions="0.32">

                    <VBox spacing="10.0" styleClass="card" maxWidth="Infinity" maxHeight="Infinity">
                        <padding>
                            <Insets bottom="15.0" left="15.0" right="15.0" top="15.0"/>
                        </padding>
                        <Label styleClass="h2" text="Files"/>
                        <TreeView fx:id="fileView" maxWidth="Infinity" maxHeight="Infinity"
                                  VBox.vgrow="ALWAYS"/>
                    </VBox>

                    <VBox spacing="12.0" styleClass="card" maxWidth="Infinity" maxHeight="Infinity">
                        <padding>
                            <Insets bottom="15.0" left="15.0" right="15.0" top="15.0"/>
                        </padding>
                        <HBox alignment="CENTER_LEFT" spacing="10.0" maxWidth="Infinity">
                            <Label styleClass="h2" text="Build Variables"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button fx:id="openFileBtn" onAction="#openFile" styleClass="btn-primary"
                                    text="Open"/>
                            <Button fx:id="saveFileBtn" onAction="#saveFile" styleClass="btn-primary"
                                    text="Save File"/>
                        </HBox>

                        <TableView fx:id="buildTable"
                                   maxWidth="Infinity"
                                   maxHeight="Infinity"
                                   VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="keyCol" prefWidth="220.0" text="Variable"/>
                                <TableColumn fx:id="valCol" prefWidth="700.0" text="Value"/>
                            </columns>
                        </TableView>

                    </VBox>

                </SplitPane>
            </Tab>

            <Tab text="Build Options">
                <BorderPane>

                    <top>
                        <VBox spacing="10.0" styleClass="card" maxWidth="Infinity">
                            <padding>
                                <Insets bottom="12.0" left="15.0" right="15.0" top="15.0"/>
                            </padding>
                            <Label styleClass="h2" text="Build Options:"/>
                        </VBox>
                    </top>

                    <center>
                        <VBox styleClass="card" maxWidth="Infinity" maxHeight="Infinity">
                            <padding>
                                <Insets bottom="15.0" left="15.0" right="15.0" top="15.0"/>
                            </padding>
                            <TableView fx:id="buildOptionsTable"
                                       maxWidth="Infinity"
                                       maxHeight="Infinity"
                                       VBox.vgrow="ALWAYS">
                                <columns>
                                    <TableColumn fx:id="buildNameCol" prefWidth="220.0" text="Build Name"/>
                                    <TableColumn fx:id="buildUrlCol" prefWidth="850.0" text="Download URL"/>
                                </columns>
                            </TableView>
                        </VBox>
                    </center>

                    <bottom>
                        <HBox spacing="10.0" styleClass="card" maxWidth="Infinity" alignment="CENTER_LEFT">
                            <padding>
                                <Insets bottom="15.0" left="15.0" right="15.0" top="12.0"/>
                            </padding>
                            <Button fx:id="addBuildOptionBtn"
                                    onAction="#addBuildOption"
                                    prefHeight="35.0"
                                    styleClass="btn-primary"
                                    text="Add Build"/>
                            <Button fx:id="removeBuildOptionBtn"
                                    onAction="#removeBuildOption"
                                    prefHeight="35.0"
                                    styleClass="btn-danger"
                                    text="Remove"/>
                            <Region HBox.hgrow="ALWAYS"/>
                        </HBox>
                    </bottom>

                </BorderPane>
            </Tab>

            <Tab text="External Join">
                <ScrollPane fitToWidth="true" hbarPolicy="NEVER">
                    <VBox spacing="20.0" styleClass="card" maxWidth="Infinity">
                        <padding>
                            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
                        </padding>
                        <Label styleClass="h2" text="Enable External Join"/>
                        <Label styleClass="muted"
                               text="Configure NAT traversal to allow external players to join your server."
                               wrapText="true"/>

                        <VBox spacing="10.0" maxWidth="Infinity">
                            <Button fx:id="enableExternalJoinBtn"
                                    maxWidth="Infinity"
                                    onAction="#enableExternalJoin"
                                    prefHeight="40.0"
                                    styleClass="btn-primary"
                                    text="Enable External Join"/>
                            <Button fx:id="disableExternalJoinBtn"
                                    disable="true"
                                    maxWidth="Infinity"
                                    onAction="#disableExternalJoin"
                                    prefHeight="40.0"
                                    styleClass="btn-danger"
                                    text="Disable External Join"/>
                        </VBox>

                        <ProgressBar fx:id="networkProgressBar"
                                     maxWidth="Infinity"
                                     progress="0.0"
                                     visible="false"/>

                        <VBox fx:id="networkResultBox" spacing="10.0" visible="false" maxWidth="Infinity">
                            <Label fx:id="networkStatusLabel" styleClass="h3" wrapText="true"/>
                            <Label fx:id="networkJoinAddressLabel" styleClass="muted"
                                   wrapText="true"/>
                            <HBox spacing="10.0" maxWidth="Infinity">
                                <TextField fx:id="joinAddressField" editable="false"
                                           HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                                <Button fx:id="copyJoinAddressBtn" onAction="#copyJoinAddress"
                                        text="Copy"/>
                            </HBox>
                        </VBox>

                        <VBox fx:id="networkErrorBox" spacing="10.0" visible="false" maxWidth="Infinity">
                            <Label fx:id="networkErrorLabel" styleClass="muted"
                                   wrapText="true"/>
                        </VBox>

                        <VBox fx:id="vpnFallbackBox" spacing="10.0" visible="false" maxWidth="Infinity">
                            <Label styleClass="h3" text="Direct join not possible" wrapText="true"/>
                            <Label fx:id="vpnReasonLabel" styleClass="muted" wrapText="true"/>
                            <Button fx:id="showVpnHelpBtn" maxWidth="Infinity" onAction="#showVpnHelp"
                                    text="Use VPN Instead"/>
                            <VBox fx:id="vpnHelpBox" spacing="5.0" visible="false" maxWidth="Infinity">
                                <padding>
                                    <Insets left="15.0"/>
                                </padding>
                                <Label styleClass="h3" text="Recommended VPN Solutions:"/>
                                <Label styleClass="muted" text="• Tailscale - Free tier, easy setup"
                                       wrapText="true"/>
                                <Label styleClass="muted"
                                       text="• ZeroTier - Open source alternative" wrapText="true"/>
                                <Label styleClass="muted"
                                       text="After both players join the same VPN network, use the VPN IP address to connect instead of the public IP."
                                       wrapText="true"/>
                            </VBox>
                        </VBox>

                    </VBox>
                </ScrollPane>
            </Tab>

            <Tab text="Plugin Marketplace">
                <BorderPane>
                    <top>
                        <VBox spacing="12.0" styleClass="card" maxWidth="Infinity">
                            <padding>
                                <Insets bottom="15.0" left="20.0" right="20.0" top="15.0"/>
                            </padding>
                            <HBox spacing="15.0" alignment="CENTER_LEFT" maxWidth="Infinity">
                                <Label styleClass="h1" text="Plugin Marketplace"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Button fx:id="pluginRefreshBtn" onAction="#refreshPlugins" text="Refresh"/>
                            </HBox>

                            <HBox spacing="10.0" maxWidth="Infinity">
                                <TextField fx:id="pluginSearchField" promptText="Search plugins..."
                                           HBox.hgrow="ALWAYS" maxWidth="Infinity"
                                           onAction="#searchPlugins"/>
                                <Button fx:id="pluginSearchBtn" onAction="#searchPlugins"
                                        styleClass="btn-primary" text="Search"/>
                            </HBox>

                            <HBox spacing="10.0" alignment="CENTER_LEFT" maxWidth="Infinity">
                                <Button text="Most Popular" onAction="#showPopular" styleClass="btn-ghost"/>
                                <Button text="Newest" onAction="#showNewest" styleClass="btn-ghost"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label fx:id="pluginStatusLabel" styleClass="muted" text="Ready"/>
                            </HBox>

                            <ProgressBar fx:id="pluginProgressBar" maxWidth="Infinity" progress="0.0"
                                         visible="false"/>
                        </VBox>
                    </top>

                    <center>
                        <SplitPane dividerPositions="0.65">
                            <ScrollPane fitToWidth="true" hbarPolicy="NEVER">
                                <VBox fx:id="pluginGridContainer" spacing="15.0" maxWidth="Infinity">
                                    <padding>
                                        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0"/>
                                    </padding>
                                    <GridPane fx:id="pluginGridPane" hgap="15.0" vgap="15.0"
                                              maxWidth="Infinity"/>
                                </VBox>
                            </ScrollPane>

                            <VBox spacing="15.0" styleClass="card" maxWidth="Infinity" maxHeight="Infinity">
                                <padding>
                                    <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
                                </padding>
                                <VBox spacing="15.0" maxWidth="Infinity">
                                    <HBox spacing="15.0" alignment="CENTER_LEFT" maxWidth="Infinity">
                                        <VBox>
                                            <ImageView fx:id="pluginIconView"
                                                       fitWidth="80.0"
                                                       fitHeight="80.0"
                                                       preserveRatio="true"
                                                       pickOnBounds="true"/>
                                        </VBox>
                                        <VBox spacing="5.0" maxWidth="Infinity">
                                            <Label fx:id="pluginNameLabel" styleClass="h1"
                                                   text="Select a Plugin"/>
                                            <Label fx:id="pluginAuthorLabel" styleClass="muted"
                                            />
                                            <HBox spacing="10.0" alignment="CENTER_LEFT">
                                                <Label fx:id="pluginDownloadsLabel"
                                                       styleClass="muted"/>
                                                <Label fx:id="pluginRatingLabel" styleClass="muted"
                                                />
                                                <Label fx:id="pluginPriceLabel" styleClass="muted"
                                                />
                                            </HBox>
                                        </VBox>
                                    </HBox>
                                </VBox>

                                <Separator/>

                                <VBox spacing="10.0" maxWidth="Infinity">
                                    <Label styleClass="h2" text="Description"/>
                                    <ScrollPane fitToWidth="true" hbarPolicy="NEVER"
                                                maxHeight="200.0">
                                        <TextArea fx:id="pluginDescriptionArea"
                                                  editable="false"
                                                  wrapText="true"
                                                  styleClass="console"
                                                  maxWidth="Infinity"/>
                                    </ScrollPane>
                                </VBox>

                                <Region VBox.vgrow="ALWAYS"/>

                                <VBox spacing="10.0" maxWidth="Infinity">
                                    <Label styleClass="h2" text="Install to Server:"/>
                                    <ListView fx:id="serverSelectListView"
                                              maxWidth="Infinity"
                                              prefHeight="100.0"/>
                                    <Button fx:id="pluginInstallBtn"
                                            onAction="#installPlugin"
                                            prefHeight="40.0"
                                            maxWidth="Infinity"
                                            styleClass="btn-primary"
                                            text="Install Plugin"
                                            disable="true"/>
                                </VBox>

                            </VBox>
                        </SplitPane>
                    </center>
                </BorderPane>
            </Tab>

        </TabPane>
    </center>

</BorderPane>
